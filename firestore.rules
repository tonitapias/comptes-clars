rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    match /artifacts/{appId}/public/data/trips/{tripId} {
      
      function isTripMemberBefore() {
        return isAuthenticated() && request.auth.uid in resource.data.memberUids;
      }

      // Un usuari NO membre només pot escriure per unir-se: l'escriptura s'ha de
      // limitar a `users`/`memberUids` i ha d'incloure el seu propi uid al resultat.
      // Sense això, qualsevol autenticat podia reescriure qualsevol altre camp
      // (nom, isDeleted, ownerId...) d'un viatge que no era seu.
      //
      // [FIX SEGURETAT]: només comprovar "el meu uid hi és present" no bastava
      // — un client fent una crida Firestore directa (saltant-se la UI) podia
      // afegir a memberUids l'uid d'una tercera persona (no només el propi),
      // o injectar entrades arbitràries a `users`, sempre que el seu propi uid
      // també hi fos. Ara es valida que memberUids només creix amb EXACTAMENT
      // el propi uid (res s'elimina ni s'afegeix d'altri), i que `users` o bé
      // no canvia (reincorporació per email: joinTripViaLink ja tenia una
      // entrada placeholder amb el mateix email/linkedUid) o bé creix amb
      // EXACTAMENT una entrada nova enllaçada al propi uid, sense tocar cap
      // entrada existent — coincidint amb els dos únics camins reals de
      // joinTripViaLink a tripService.ts.
      function isSelfJoin() {
        let oldData = resource.data;
        let newData = request.resource.data;
        let uid = request.auth.uid;

        let memberUidsOk =
          newData.memberUids.hasAll(oldData.memberUids) &&
          newData.memberUids.size() <= oldData.memberUids.size() + 1 &&
          uid in newData.memberUids;

        // removeAll() dona els elements de `users` que no eren a l'antic
        // `users` — independent de la posició (a diferència de mirar
        // l'últim element, que només seria correcte si sempre s'usés
        // arrayUnion i mai un update() amb l'array reordenat a mà).
        let addedUsers = newData.users.removeAll(oldData.users);
        let usersOk = newData.users == oldData.users || (
          newData.users.size() == oldData.users.size() + 1 &&
          newData.users.hasAll(oldData.users) &&
          addedUsers.size() == 1 &&
          addedUsers[0].linkedUid == uid
        );

        return isAuthenticated()
          && newData.diff(oldData).affectedKeys().hasOnly(['users', 'memberUids'])
          && memberUidsOk
          && usersOk;
      }

      // Propietari: `ownerId` si existeix; pels viatges anteriors a aquest camp,
      // el primer membre històric (mateix criteri que useTripMutations.ts:isUserOwner).
      function isTripOwner() {
        return isAuthenticated() && (
          resource.data.ownerId == request.auth.uid ||
          (!('ownerId' in resource.data) && resource.data.memberUids[0] == request.auth.uid)
        );
      }

      // REGLES DEL DOCUMENT PRINCIPAL
      allow create: if isAuthenticated();
      // `get` (per ID) es manté obert a qualsevol autenticat: joinTripViaLink necessita
      // llegir `users` d'un viatge abans de ser-ne membre (per detectar reincorporacions
      // per email) i el codi/enllaç d'invitació ja fa de "capability" — cal conèixer
      // l'ID concret per fer-hi un `get`.
      // `list` és el que cal restringir: sense això, qualsevol autenticat podia fer una
      // query sense filtre i llistar TOTS els viatges de la base de dades. En exigir
      // que l'uid autenticat aparegui a `memberUids`, Firestore obliga que qualsevol
      // query amb `list` inclogui `where('memberUids', 'array-contains', request.auth.uid)`
      // — exactament el que ja fa TripService.getUserTrips — i rebutja qualsevol altra.
      allow get: if isAuthenticated();
      allow list: if isAuthenticated() && request.auth.uid in resource.data.memberUids;
      allow update: if isTripMemberBefore() || isSelfJoin();
      allow delete: if isTripOwner();

      // [FIX DEFINITIU]: Comprovem si l'usuari és membre ARA MATEIX (get) 
      // o si ho serà DESPRÉS de l'operació (getAfter). 
      // Això permet transaccions atòmiques tant per UNIR-SE com per SORTIR.
      function isParentTripMember() {
        let docPath = /databases/$(database)/documents/artifacts/$(appId)/public/data/trips/$(tripId);
        
        let isMemberBefore = get(docPath) != null && request.auth.uid in get(docPath).data.memberUids;
        let isMemberAfter = getAfter(docPath) != null && request.auth.uid in getAfter(docPath).data.memberUids;
        
        return isAuthenticated() && (isMemberBefore || isMemberAfter);
      }

      // Autoritzem les subcol·leccions
      match /expenses/{expenseId} {
        allow read, write: if isParentTripMember();
      }
      
      match /payments/{paymentId} {
        allow read, write: if isParentTripMember();
      }
      
      match /logs/{logId} {
        allow read, write: if isParentTripMember();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}